<?xml version="1.0" encoding="utf-8"?>
<!-- Sağlık verisi ve anahtarlar bulut yedeğine ve cihazdan cihaza aktarıma
     girmez (Android 12+). Eski sürümlerde android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
